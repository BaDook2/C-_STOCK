<UserControl x:Class="Stock.App.OversoldParameterPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.App">
 <StackPanel Margin="0,14,0,20" TextElement.FontSize="12" TextElement.FontWeight="Normal">
   <TextBlock Text="{Binding OversoldMessage}" TextWrapping="Wrap" Foreground="#6B7684" Margin="0,8"/>
   <Expander Header="시점별 검증 자료 (고급)" Margin="0,8,0,12">
    <StackPanel>
     <TextBlock Text="공개 OHLCV에는 당시 분류·관리/정지 여부·실제 거래대금·위험 정보가 없습니다. 해당 시점에 알려진 자료(KnownAt)와 검증된 시장일을 입력해야 진입할 수 있습니다. 누락값을 안전으로 간주하지 않습니다. 형식은 docs/api/OversoldHistoricalFacts.md에 설명되어 있습니다." TextWrapping="Wrap" Margin="0,8"/>
     <Button Content="시점 자료 JSON 읽기" Command="{Binding Actions[낙주자료불러오기]}" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/>
     <TextBox Text="{Binding OversoldFactsJson,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas" Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding CanConfigure}"/>
    </StackPanel>
   </Expander>
   <ItemsControl ItemsSource="{Binding OversoldUsageGroups}" IsEnabled="{Binding CanConfigure}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="White" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
     <Expander IsExpanded="True">
      <Expander.Header><WrapPanel><TextBlock Text="{Binding Metadata.Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Count,StringFormat={} · {0:N0}개}" Foreground="#8B95A1" FontSize="14" VerticalAlignment="Center"/></WrapPanel></Expander.Header>
      <StackPanel Margin="0,10,0,0">
       <TextBlock Text="{Binding Metadata.Description}" TextWrapping="Wrap" Foreground="#333D4B"/>
       <Border Background="#F2F7FF" CornerRadius="8" Padding="12" Margin="0,8,0,12"><TextBlock Text="{Binding Metadata.Status}" TextWrapping="Wrap" Foreground="#46658B"/></Border>
       <TextBlock Text="{Binding Metadata.EmptyMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}"/>
       <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
    <Expander Header="{Binding Name}" IsExpanded="False" Margin="0,0,0,10"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
     <ItemsControl ItemsSource="{Binding Cells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Margin="0,8,8,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Border DataContext="{Binding Field}" Background="#F7F9FC" CornerRadius="10" Padding="10" MinHeight="145"><StackPanel>
      <StackPanel.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="32"/><Setter Property="Width" Value="180"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalAlignment" Value="Left"/></Style></StackPanel.Resources>
      <DockPanel><Button DockPanel.Dock="Right" Content="?" ToolTip="{Binding Metadata.ShortDescription}" Click="HelpClick" Style="{StaticResource Secondary}" Width="25" Height="25" Padding="0" Margin="6,0,0,0"/><TextBlock Text="{Binding Metadata.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
      <CheckBox Content="사용" IsChecked="{Binding BoolValue}" Visibility="{Binding IsBool,Converter={StaticResource Visible}}" ToolTip="{Binding Metadata.ShortDescription}" Height="32"/>
      <ComboBox ItemsSource="{Binding Choices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Value}" Visibility="{Binding IsEnum,Converter={StaticResource Visible}}" Height="32" MaxWidth="240" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      <TextBox x:Name="ParameterEditor" Text="{Binding InputText,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" local:FixedDecimalInput.Kind="{Binding Metadata.InputKind}" Visibility="{Binding IsText,Converter={StaticResource Visible}}" ToolTip="{Binding InputTooltip}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding ElementName=ParameterEditor,Path=(local:FixedDecimalInput.Error)}" Foreground="#C73545" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Range}" FontSize="10" Foreground="#6B7684" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Foreground="#C73545" FontSize="10" TextWrapping="Wrap"/>
     </StackPanel></Border></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Expander>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
