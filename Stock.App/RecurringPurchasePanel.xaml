<UserControl x:Class="Stock.App.RecurringPurchasePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.App">
 <Grid Margin="0,4,0,0"><Grid.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="7,4"/></Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,7"/></Style></Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border CornerRadius="12" BorderBrush="#E5EAF0" BorderThickness="1" Padding="8"><StackPanel>
   <TextBlock Text="정기매수 백테스트 설정" FontSize="15" FontWeight="Bold"/>
   <TextBlock Text="같은 종목을 정기적으로 매수했을 때의 과거 성과를 확인합니다." TextWrapping="Wrap" Foreground="#8B95A1" FontSize="14" Margin="0,4,0,6"/>
   <Grid IsEnabled="{Binding CanConfigure}"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:RecurringParameterCaption Parameter="From" CurrentValue="{Binding From,StringFormat=yyyy.MM.dd}"/><WrapPanel Grid.Column="1" Margin="0,2"><DatePicker SelectedDate="{Binding From}" Width="140"/><TextBlock Text=" ~ " VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding To}" Width="140"/></WrapPanel>
    <local:RecurringParameterCaption Grid.Row="1" Parameter="Frequency" CurrentValue="{Binding RecurringFrequencyText}"/><UniformGrid Grid.Row="1" Grid.Column="1" Columns="3" Margin="0,2"><RadioButton Content="매일" IsChecked="{Binding RecurringDaily}" GroupName="RecurringFrequency" Padding="10,6"/><RadioButton Content="매주" IsChecked="{Binding RecurringWeekly}" GroupName="RecurringFrequency" Padding="10,6"/><RadioButton Content="매월" IsChecked="{Binding RecurringMonthly}" GroupName="RecurringFrequency" Padding="10,6"/></UniformGrid>
    <local:RecurringParameterCaption Grid.Row="2" Parameter="Timing" CurrentValue="{Binding RecurringTimingText}"/><UniformGrid Grid.Row="2" Grid.Column="1" Columns="2" Margin="0,2"><RadioButton Content="시가" IsChecked="{Binding RecurringAtOpen}" GroupName="RecurringTiming" Padding="10,6"/><RadioButton Content="종가" IsChecked="{Binding RecurringAtClose}" GroupName="RecurringTiming" Padding="10,6"/></UniformGrid>
    <local:RecurringParameterCaption Grid.Row="3" Parameter="Amount" CurrentValue="{Binding RecurringAmount}"/><DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding StockCurrency}" Margin="8,0" VerticalAlignment="Center"/><TextBox Text="{Binding RecurringAmount,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
    <local:RecurringParameterCaption Grid.Row="4" Parameter="InitialAmount" CurrentValue="{Binding RecurringInitial}"/><DockPanel Grid.Row="4" Grid.Column="1" Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding StockCurrency}" Margin="8,0" VerticalAlignment="Center"/><TextBox Text="{Binding RecurringInitial,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
    <local:RecurringParameterCaption Grid.Row="5" Parameter="CommissionPercent" CurrentValue="{Binding RecurringFee}"/><DockPanel Grid.Row="5" Grid.Column="1" Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="%" Margin="8,0" VerticalAlignment="Center"/><TextBox Text="{Binding RecurringFee,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
   </Grid>
   <WrapPanel><CheckBox Content="배당 재투자" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="현재 데이터 제공처에 검증된 배당 지급 자료가 없어 계산에 포함하지 않습니다."/><CheckBox Content="매수 내역 차트 표시" IsChecked="{Binding ShowRecurringMarkers}"/></WrapPanel>
   <UniformGrid Columns="2"><Button Content="정기매수 실행" Command="{Binding Actions[정기매수실행]}" Background="#3182F6" Foreground="White"/><Button Content="초기화" Command="{Binding Actions[정기매수초기화]}" Style="{StaticResource Secondary}"/></UniformGrid>
   <TextBlock Text="{Binding RecurringNotice}" ToolTip="{Binding RecurringNotice}" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="#8B95A1" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Border Grid.Row="2" CornerRadius="12" BorderBrush="#E5EAF0" BorderThickness="1" Padding="8"><StackPanel>
   <TextBlock Text="백테스트 결과" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding RecurringResultPeriod}" FontSize="14" Foreground="#8B95A1" TextWrapping="Wrap" Margin="0,8,0,10"/>
   <ItemsControl ItemsSource="{Binding RecurringCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F6F8FA" CornerRadius="9" Margin="0,0,6,6" Padding="8"><StackPanel><TextBlock Text="{Binding Label}" FontSize="14" Foreground="#6B7684"/><TextBlock Text="{Binding Value}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="추가 지표" FontWeight="SemiBold" Margin="0,8"/><TextBlock Text="{Binding RecurringDetails}" TextWrapping="Wrap" FontSize="14" LineHeight="18" Foreground="#6B7684"/>
  </StackPanel></Border>
 </Grid>
</UserControl>
