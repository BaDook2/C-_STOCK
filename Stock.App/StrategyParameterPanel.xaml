<UserControl x:Class="Stock.App.StrategyParameterPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="실제 체결 전략 설정" FontSize="23" FontWeight="Bold"/>
  <WrapPanel IsEnabled="{Binding CanConfigure}" Margin="0,12,0,4"><TextBlock Text="설정 모드" VerticalAlignment="Center" Margin="0,0,12,0"/><RadioButton Content="Standard" GroupName="StrategyConfigMode" IsChecked="{Binding StandardMode}"/><RadioButton Content="Advanced" GroupName="StrategyConfigMode" IsChecked="{Binding AdvancedMode}"/><Border Background="#EAF2FF" CornerRadius="7" Padding="10,6" Margin="14,0"><TextBlock Text="{Binding ConfigurationState}" Foreground="#1967D2"/></Border><ComboBox ItemsSource="{Binding StrategyChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding StrategyChoice}" Width="300"/></WrapPanel>
  <WrapPanel><CheckBox Content="이 설정으로 실제 체결 전략 사용" IsChecked="{Binding UseConfiguredStrategy}" IsEnabled="{Binding CanConfigure}" ToolTip="저장된 실제 틱 백테스트와 온라인 틱 신호에 적용합니다. 실제 주문은 온라인 투자에서 전략 다중매매를 별도 실행해야 합니다."/><Button Content="설정 적용 · 저장" Command="{Binding Actions[전략설정저장]}" Padding="12,7"/><Button Content="저장된 틱 백테스트" Command="{Binding Actions[틱백테스트]}" Padding="12,7" Style="{StaticResource Secondary}" ToolTip="차트의 시작·종료 기간에 저장된 실제 체결·호가를 같은 엔진으로 재생합니다."/></WrapPanel>
  <TextBlock Text="{Binding ConfigurationMessage}" TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#6B7684"/>
  <StackPanel Visibility="{Binding IsPipeline,Converter={StaticResource Visible}}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,16">
   <ComboBox ItemsSource="{Binding PipelineStrategyChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding PipelineStrategyChoice}" Width="260" HorizontalAlignment="Left"/>
   <Expander Header="검색순위 자료 · 수동 / CSV / Mock" Margin="0,10,0,0"><StackPanel>
    <TextBox Text="{Binding RankingInput,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    <WrapPanel><Button Content="수동 자료 적용" Command="{Binding Actions[순위자료적용]}"/><Button Content="순위 CSV 불러오기" Command="{Binding Actions[순위CSV]}" Style="{StaticResource Secondary}"/><Button Content="Mock 흐름 검사" Command="{Binding Actions[파이프라인Mock]}" Style="{StaticResource Secondary}"/></WrapPanel>
   </StackPanel></Expander>
   <TextBlock Text="{Binding PipelineStatus}" TextWrapping="Wrap" Foreground="#6B7684" Margin="0,10"/>
   <ItemsControl ItemsSource="{Binding PipelineStages}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Stage}" Width="160"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <ItemsControl ItemsSource="{Binding ParameterGroups}" IsEnabled="{Binding CanConfigure}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,14" FontWeight="SemiBold"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="#F7F9FC" CornerRadius="12" Padding="14" Margin="0,9,12,0" Width="300" MinHeight="154"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="?" ToolTip="{Binding Metadata.ShortDescription}" Click="HelpClick" Style="{StaticResource Secondary}" Width="25" Height="25" Padding="0" Margin="6,0,0,0"/><TextBlock Text="{Binding Metadata.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
    <TextBlock Text="{Binding Metadata.Key}" FontSize="10" Foreground="#8B95A1" Margin="0,3,0,5"/>
    <CheckBox Content="사용" IsChecked="{Binding BoolValue}" Visibility="{Binding IsBool,Converter={StaticResource Visible}}" ToolTip="{Binding Metadata.ShortDescription}"/>
    <ComboBox ItemsSource="{Binding Choices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Value}" Visibility="{Binding IsEnum,Converter={StaticResource Visible}}"/>
    <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Visibility="{Binding IsText,Converter={StaticResource Visible}}" ToolTip="{Binding Metadata.ShortDescription}"/>
    <TextBlock Text="{Binding Range}" FontSize="10" Foreground="#6B7684" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Foreground="#C73545" FontSize="10" TextWrapping="Wrap"/>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
