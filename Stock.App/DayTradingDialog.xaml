<Window x:Class="Stock.App.DayTradingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.App"
 Title="전략 D · 설정 / 백테스트 / 실시간 가상 실행" Width="1420" Height="960" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="전략 D · 당일 반복매매" FontSize="25" FontWeight="Bold"/>
   <TextBlock Text="일봉 MA + 거래량 매물대 중첩 → 지지 접근 후 새 반등 → 체결 기반 포지션 관리" Foreground="#6B7684" Margin="0,6,0,10"/>
   <Border Background="#EAF2FF" CornerRadius="10" Padding="12"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#244C80"/></Border>
  </StackPanel>
  <TabControl x:Name="Pages" Margin="0,12,0,0" SelectionChanged="PageChanged">
   <TabItem Header="전략 설정">
    <DockPanel Margin="8,12">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel IsEnabled="{Binding Editable}">
       <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Width="235" ToolTip="저장한 전략 D 설정. 기존 낙주 전략과 별도 버전으로 보관합니다."/>
       <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="전략 D 저장 이름 · 1~80자"/>
       <Button Content="추가" Command="{Binding Commands[추가]}"/>
       <Button Content="저장" Command="{Binding Commands[저장]}"/>
       <Button Content="복구" Command="{Binding Commands[복구]}" Style="{StaticResource Secondary}"/>
       <Button Content="불러오기" Command="{Binding Commands[불러오기]}" Style="{StaticResource Secondary}"/>
       <Button Content="내보내기" Command="{Binding Commands[내보내기]}" Style="{StaticResource Secondary}"/>
       <CheckBox Content="고급 설정" IsChecked="{Binding Advanced}" Margin="14,0"/>
      </WrapPanel>
      <TextBlock Text="간편 모드는 주요 수치를 표시합니다. 고급 모드에서 급락 결합·기간·재진입·자료 안전을 조정합니다. 실행 중 설정 변경은 다음 시작 때 적용됩니다." TextWrapping="Wrap" Foreground="#6B7684" Margin="0,8"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding Editable}"><ItemsControl.ItemTemplate><DataTemplate>
        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,8">
         <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="White" CornerRadius="9" Padding="10,8" Margin="0,6,8,0" Width="305" ToolTip="{Binding Help}">
           <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel>
             <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" FontSize="11" Foreground="#6B7684" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" MaxWidth="105"/>
             <Grid>
              <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" Height="32" Visibility="{Binding IsText,Converter={StaticResource Visible}}"/>
              <CheckBox Content="사용" IsChecked="{Binding BoolValue}" Height="32" Visibility="{Binding IsBool,Converter={StaticResource Visible}}"/>
              <ComboBox ItemsSource="{Binding Choices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Text}" Height="32" Visibility="{Binding IsChoice,Converter={StaticResource Visible}}"/>
             </Grid>
            </DockPanel>
           </StackPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Expander>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="시점별 종목 상태·위험·시장 세션 자료 (JSON)" Margin="0,12">
        <StackPanel><TextBlock Text="당시 알려진 자료만 사용합니다. 실시간 실행에서 자료가 없거나 시각이 추정되면 신규 진입을 차단합니다. 연구 가정은 실시간 가상 실행에 전이하지 않습니다." TextWrapping="Wrap" Margin="0,8"/>
         <TextBox Text="{Binding FactsJson,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="200" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="백테스트 · 스크리닝">
    <Grid Margin="8,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <WrapPanel>
       <TextBlock Text="기간" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding StartDate}" Width="145"/><TextBlock Text="~" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding EndDate}" Width="145"/>
       <TextBlock Text="가상 시드(원)" VerticalAlignment="Center" Margin="10,0"/><TextBox Text="{Binding SeedCash,UpdateSourceTrigger=PropertyChanged}" Width="135"/>
       <Button Content="백테스트" Command="{Binding Commands[연구]}"/><Button Content="대상 종목 스크리닝" Command="{Binding Commands[스크리닝]}"/>
       <Button Content="취소" Command="{Binding Commands[취소]}" Style="{StaticResource Secondary}"/>
      </WrapPanel>
      <WrapPanel Margin="0,8"><CheckBox Content="수집 원본 이벤트 재생" IsChecked="{Binding RawReplay}" ToolTip="현재 프로세스에서 확보한 원본 체결·수신시각이 필요합니다. 미확보 시 실행을 차단하며 OHLCV로 대체하지 않습니다."/>
       <CheckBox Content="봉 연구 가정 허용" IsChecked="{Binding ResearchAssumptions}" Margin="20,0" ToolTip="연구에서만 관측일의 정규장 시각/거래대금 추정/미확인 종목·위험을 명시적 가정으로 사용합니다. 알려진 위험은 덮어쓰지 않습니다. 실제 틱 재현이 아닙니다."/>
      </WrapPanel>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResearch}" Margin="0,6,0,10"><DataGrid.Columns>
      <DataGridTextColumn Header="코드" Binding="{Binding Symbol}" Width="100"/><DataGridTextColumn Header="종목" Binding="{Binding Name}" Width="150"/>
      <DataGridTextColumn Header="신호" Binding="{Binding Signals}" Width="65"/><DataGridTextColumn Header="완결 거래" Binding="{Binding Trades}" Width="95"/>
      <DataGridTextColumn Header="평가손익" Binding="{Binding Profit}" Width="110"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="*"/>
     </DataGrid.Columns></DataGrid>
     <local:DayTradingChartPanel Grid.Row="2"/>
    </Grid>
   </TabItem>
   <TabItem Header="실시간 가상 실행">
    <Grid Margin="8,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <WrapPanel>
       <TextBlock Text="공유 가상 시드(원)" VerticalAlignment="Center"/><TextBox Text="{Binding SeedCash,UpdateSourceTrigger=PropertyChanged}" Width="160"/>
       <CheckBox Content="신규·추가매수 허용" IsChecked="{Binding AutomaticEntries}" Margin="16,0" ToolTip="기본 OFF. 켠 이후 새 신호만 가상 주문합니다. 끄면 신규·추가매수만 중지하며 기존 보유 보호는 유지됩니다."/>
       <Button Content="가상 감시 시작" Command="{Binding Commands[가상시작]}"/><Button Content="신규 진입 중지" Command="{Binding Commands[진입중지]}" Style="{StaticResource Secondary}"/>
       <Button Content="긴급중지" Command="{Binding Commands[긴급중지]}" Background="#FFE3E8" Foreground="#C73545"/>
      </WrapPanel>
      <TextBlock Text="{Binding Connection}" Margin="0,8" FontWeight="SemiBold"/>
      <TextBlock Text="온라인 국내 체결 스트림 · 최대20종목 · 팝업 종료 후에도 감시 유지 · 실계좌 주문 연결 없음 · 시각/연속성/당시 위험 미확인 시 진입 차단" TextWrapping="Wrap" Foreground="#6B7684"/>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding LiveRows}" SelectedItem="{Binding SelectedLive}" Margin="0,8"><DataGrid.Columns>
      <DataGridTextColumn Header="종목" Binding="{Binding Symbol}" Width="110"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="*"/>
      <DataGridTextColumn Header="보유" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="평균단가" Binding="{Binding Average,Converter={StaticResource IntegerPrice}}" Width="110"/>
      <DataGridTextColumn Header="진입 횟수" Binding="{Binding Entries}" Width="90"/><DataGridTextColumn Header="실현손익" Binding="{Binding RealizedProfit,Converter={StaticResource IntegerPrice}}" Width="110"/>
      <DataGridTextColumn Header="자료/실행 오류" Binding="{Binding Error}" Width="*"/>
     </DataGrid.Columns></DataGrid>
     <local:DayTradingChartPanel Grid.Row="2"/>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
