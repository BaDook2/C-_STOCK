<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.StrategyPanel">
    <UserControl.Resources>
        <DataTemplate x:Key="ParameterGroup">
            <Expander Header="{Binding Name}" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,6" FontSize="14">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F7F9FC" CornerRadius="8" Width="290" Padding="10" Margin="0,4,8,4" ToolTip.Tip="{Binding Help}">
                                <StackPanel Spacing="6">
                                    <DockPanel><Button DockPanel.Dock="Right" Content="?" Click="HelpClick" Classes="secondary" Padding="5,0" MinHeight="20" /><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel>
                                    <local:SettingInput />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="전략 설정" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="두 전략 중 하나를 선택하고, 각 전략의 파라미터를 관리합니다." Foreground="#6B7684" Margin="0,12" />
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Names}" SelectedItem="{Binding Selected,Mode=TwoWay}" IsEditable="True" Text="{Binding Name,Mode=TwoWay}" Width="250" />
                <Button Content="추가" Command="{Binding Add}" /><Button Content="이름 변경" Command="{Binding Rename}" Classes="secondary" />
                <Button Content="설정 저장" Command="{Binding Save}" /><Button Content="복구" Command="{Binding Restore}" Classes="secondary" />
                <Button Content="불러오기" Command="{Binding Import}" Classes="secondary" /><Button Content="다운로드" Command="{Binding Export}" Classes="secondary" />
                <Button Content="기본값" Command="{Binding Defaults}" Classes="secondary" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,14,0,20">
                <TextBlock Text="{Binding Message}" Foreground="#6B7684" FontSize="12" TextWrapping="Wrap" Margin="0,8" />
                <Border BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="8,0">
                            <TextBlock Text="Inje's Strategy" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="InjeUse" Content="사용" IsChecked="{Binding UseInje,Mode=TwoWay}" />
                        </StackPanel>
                        <Expander x:Name="InjeStrategyExpander" Header="파라미터" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="실행할 Inje 전략" Margin="0,4,0,6" />
                                <ComboBox x:Name="InjeAlgorithm" ItemsSource="{Binding InjeChoices}" DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding InjeId,Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                <ItemsControl ItemsSource="{Binding InjeGroups}" ItemTemplate="{StaticResource ParameterGroup}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="8,0">
                            <TextBlock Text="Bin's Strategy" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="BinUse" Content="사용" IsChecked="{Binding UseBin,Mode=TwoWay}" />
                        </StackPanel>
                        <Expander x:Name="BinStrategyExpander" Header="파라미터" IsExpanded="False" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Bin은 백테스트·스크리닝에 사용할 수 있습니다. 실시간 가상 주문은 중단 후 복원 기능을 연결할 때까지 시작할 수 없습니다." TextWrapping="Wrap" Foreground="#6B7684" Margin="0,8" />
                                <TextBlock Text="가상 초기 현금 · 통화별 독립 계좌" FontWeight="SemiBold" Margin="0,8" />
                                <WrapPanel>
                                    <StackPanel Width="280" Margin="0,0,12,0"><TextBlock Text="미국 · USD" /><TextBox Text="{Binding BinCashUsd,Mode=TwoWay}" /></StackPanel>
                                    <StackPanel Width="280"><TextBlock Text="한국 · KRW" /><TextBox Text="{Binding BinCashKrw,Mode=TwoWay}" /></StackPanel>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding BinGroups}" ItemTemplate="{StaticResource ParameterGroup}" />
                                <TextBlock Text="국가별 비용표는 적용 시작일·종료일·당시 확인 시각과 출처를 입력합니다. 빈 비용표·미입력 예산은 매수를 보류합니다." TextWrapping="Wrap" Foreground="#6B7684" Margin="0,12" />
                                <WrapPanel><Button Content="KRW 비용표 추가" Command="{Binding AddKrwFee}" Classes="secondary" /><Button Content="USD 비용표 추가" Command="{Binding AddUsdFee}" Classes="secondary" /></WrapPanel>
                                <ItemsControl ItemsSource="{Binding FeeRows}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /><Button Content="비용표 삭제" Command="{Binding Remove}" Classes="secondary" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <TextBlock Text="백테스트·스크리닝은 원본 체결·호가와 당시 확인 가능한 자료로 판단합니다. 일봉만 있으면 자료 부족으로 안내합니다. 사용 체크는 다음 실행에 적용하며 진행 중인 보유분의 전략은 바꾸지 않습니다." TextWrapping="Wrap" Foreground="#6B7684" Margin="0,12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
