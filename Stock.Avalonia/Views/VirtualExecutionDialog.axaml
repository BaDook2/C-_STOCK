<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Stock.Desktop.VirtualExecutionDialog" Title="{Binding WindowTitle}" Width="1220" Height="850" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="22" RowDefinitions="Auto,*,Auto,Auto"><StackPanel Spacing="10"><TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><ComboBox ItemsSource="{Binding Groups}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding Group,Mode=TwoWay}" Width="200" Margin="0,0,10,0"/><Button Content="현재 종목 추가" Command="{Binding AddCurrent}" Classes="secondary"/><Button Content="선택 종목 제거" Command="{Binding Remove}" Classes="secondary"/></WrapPanel></StackPanel>
  <Grid Grid.Row="1" ColumnDefinitions="270,16,*" Margin="0,16"><Border Classes="card"><ScrollViewer><ItemsControl ItemsSource="{Binding Picks}" IsEnabled="{Binding Editable}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Chosen,Mode=TwoWay}" Margin="0,8"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Code}" Classes="muted" FontSize="12"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
   <Border Grid.Column="2" Classes="card"><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected,Mode=TwoWay}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="코드" Binding="{Binding Code,Mode=OneWay}" Width="85"/><DataGridTextColumn Header="종목" Binding="{Binding Name,Mode=OneWay}" Width="120"/><DataGridTemplateColumn Header="등록 전략" Width="245"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding $parent[Window].DataContext.Names}" SelectedItem="{Binding Strategy,Mode=TwoWay}" IsEnabled="{Binding $parent[Window].DataContext.Editable}" Margin="2" HorizontalAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="종목 예산" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Budget,Mode=TwoWay}" IsEnabled="{Binding $parent[Window].DataContext.Editable}" Margin="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="상태" Binding="{Binding Status,Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid></Border>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="10">   <WrapPanel IsVisible="{Binding IsVirtual}"><Button Content="보관된 가상 계좌 복원" Command="{Binding Realtime.RestoreSaved}" Classes="secondary"/><Button Content="보호 감시 재개 (신규 매수 꺼짐)" Command="{Binding Realtime.ResumeSaved}" Classes="secondary" Margin="8,0"/></WrapPanel>   <StackPanel IsVisible="{Binding IsActual}" Spacing="8"><TextBlock Text="{Binding Actual.Accounts.OrderAuthorization}" TextWrapping="Wrap"/><Button Content="실제 주문 활성화" Command="{Binding Actual.Accounts.EnableOrders}"/><Button Content="이전 실제 실행 대사 확인" Command="{Binding Actual.ReviewPrevious}" Classes="secondary"/><Expander Header="실계좌 검증 자료 (시점별 상태·위험·시장 세션·거래대금)" IsEnabled="{Binding Editable}"><StackPanel Spacing="6"><TextBlock Text="가상 가정은 실계좌에 적용하지 않습니다. 분·시간 준비 봉의 실제 거래대금은 종목키별 StrategyBar 배열 JSON으로 입력하세요." TextWrapping="Wrap" Classes="muted"/><TextBox Text="{Binding Actual.FactsJson,Mode=TwoWay}" AcceptsReturn="True" Height="90"/><TextBox Text="{Binding Actual.WarmupJson,Mode=TwoWay}" AcceptsReturn="True" Height="90"/></StackPanel></Expander></StackPanel><WrapPanel IsEnabled="{Binding Editable}"><TextBlock Text="시드머니 / 전체 투자 한도 (USD)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding TotalBudget,Mode=TwoWay}" Width="165" Margin="0,0,16,0"/><TextBlock Text="일 손실 한도 (USD)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding DailyLossLimit,Mode=TwoWay}" Width="150"/></WrapPanel>
   <WrapPanel IsEnabled="{Binding $parent[Window].DataContext.Editable}" DataContext="{Binding Analysis}" ToolTip.Tip="차트 표시용 기준입니다. Inje 진입·청산은 이 설정과 관계없이 원본 틱·호가로 판단합니다."><CheckBox Content="일봉" IsChecked="{Binding Daily,Mode=TwoWay}" Margin="0,0,12,0"/><StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanCustom}"><CheckBox Content="지정봉" IsChecked="{Binding Custom,Mode=TwoWay}"/><ComboBox ItemsSource="{Binding Values}" SelectedItem="{Binding Value,Mode=TwoWay}" Width="80"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit,Mode=TwoWay}" Width="100"/></StackPanel></WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="3" Spacing="12" Margin="0,16,0,0"><WrapPanel><Button Content="{Binding StartLabel}" Command="{Binding Start}"/><Button Content="{Binding StopLabel}" Command="{Binding Stop}" Classes="danger"/><CheckBox Content="신규·추가매수 허용" IsVisible="{Binding IsVirtual}" IsChecked="{Binding Realtime.Automatic,Mode=TwoWay}" IsEnabled="{Binding Realtime.CanAutomatic}" Margin="12,0"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted"/></StackPanel>
 </Grid>
</Window>
