<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.MarketPanel">
    <Border Classes="card" Margin="0,16,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding RefreshMarket}" Classes="secondary" />
                    <TextBlock Text="오늘의 시장" FontSize="28" FontWeight="Bold" />
                </DockPanel>
                <TextBlock Text="주요 지수와 시장의 흐름을 한눈에" Classes="muted" Margin="0,8,0,20" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <RadioButton Content="국내" GroupName="IndexMarket" IsChecked="{Binding DomesticMarket,Mode=TwoWay}" />
                    <RadioButton Content="해외" GroupName="IndexMarket" IsChecked="{Binding OverseasMarket,Mode=TwoWay}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding VisibleIndices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F7F8FA" CornerRadius="18" Padding="20" Margin="0,0,16,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Code}" FontSize="11" Classes="muted" />
                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Price}" FontSize="34" FontWeight="Bold" Margin="0,18,0,10" />
                                    <TextBlock Text="{Binding Change}" Foreground="#3182F6" FontSize="17" FontWeight="SemiBold" />
                                    <local:LineChart Points="{Binding Points}" Height="80" MinHeight="80" Margin="0,14,0,8" />
                                    <TextBlock Text="{Binding State}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Time}" Classes="muted" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="제공처가 기록한 시각의 지수입니다. 새로고침으로 최신 자료를 조회합니다." Classes="muted" FontSize="11" Margin="0,18,0,28" />
                <TextBlock Text="내가 보고 있는 종목" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />
                <Border Background="#F7F8FA" CornerRadius="14" Padding="22">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel>
                            <TextBlock Text="{Binding StockTitle}" FontSize="17" />
                            <TextBlock Text="{Binding PriceText}" FontSize="25" FontWeight="Bold" Margin="0,8,0,5" />
                            <TextBlock Text="{Binding ChangeText}" />
                            <TextBlock Text="{Binding QuoteTime}" FontSize="10" Classes="muted" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ChartDataInfo}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="16" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>