<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.ResearchBrowserPanel"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="16" Spacing="8"><TextBlock Text="{Binding Context}" Classes="muted"/><WrapPanel><Button Content="이전 종목" Command="{Binding Previous}" Classes="secondary"/><Button Content="다음 종목" Command="{Binding Next}" Classes="secondary"/><Button Content="다시 실행" Command="{Binding Retry}" Classes="secondary"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3"/></StackPanel><local:ResearchResultPanel OverviewNavigation="True" DataContext="{Binding Current}"/></DockPanel></UserControl>
