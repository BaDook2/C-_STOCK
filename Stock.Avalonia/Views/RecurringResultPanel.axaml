<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.RecurringResultPanel">
 <Grid RowDefinitions="Auto,2*,*,140" Margin="18"><StackPanel Spacing="10"><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20"/><TextBlock Text="{Binding Summary}" Foreground="#3182F6"/><TextBlock Text="일봉 시가/종가의 연구 체결 가정 · 실제 주문 없음 · 납입금을 투자수익으로 계산하지 않음" Classes="muted"/></StackPanel><local:StockChart Grid.Row="1" Bars="{Binding Bars}" Markers="{Binding Markers}" Period="일봉"/><local:LineChart Grid.Row="2" Points="{Binding Equity}"/><DataGrid Grid.Row="3" ItemsSource="{Binding Purchases}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="시각" Binding="{Binding Time,Mode=OneWay}" Width="210"/><DataGridTextColumn Header="구분" Binding="{Binding Side,Mode=OneWay}" Width="80"/><DataGridTextColumn Header="수량" Binding="{Binding Quantity,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="가격" Binding="{Binding Price,Converter={StaticResource IntegerPrice},Mode=OneWay}" Width="130"/><DataGridTextColumn Header="사유" Binding="{Binding Reason,Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
