<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.LiveChartPanel">
 <Grid RowDefinitions="Auto,*,160,100" Margin="14"><StackPanel Spacing="8"><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Foreground="#3182F6"/></StackPanel><local:StockChart OverviewNavigation="True" x:Name="Chart" Currency="{Binding Currency}" Grid.Row="1" Bars="{Binding Bars}" DailyBars="{Binding DailyBars}" Markers="{Binding Markers}" Zones="{Binding Zones}" Period="{Binding Period}"/>
  <DataGrid x:Name="Trades" Grid.Row="2" ItemsSource="{Binding Trades}" SelectedItem="{Binding Selected,Mode=TwoWay}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="시각" Binding="{Binding Time,Mode=OneWay}" Width="180"/><DataGridTextColumn Header="구분" Binding="{Binding Side,Mode=OneWay}" Width="110"/><DataGridTextColumn Header="가격" Binding="{Binding Price,Mode=OneWay}" Width="110"/><DataGridTextColumn Header="수량" Binding="{Binding Quantity,Mode=OneWay}" Width="80"/><DataGridTextColumn Header="손익" Binding="{Binding Profit,Mode=OneWay}" Width="140"/><DataGridTextColumn Header="사유" Binding="{Binding Reason,Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="3" Text="{Binding Detail,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
