<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.DayTradingDialog" Title="전략 D · 당일 반복매매" Width="1380" Height="960" MinWidth="1050" MinHeight="720" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Spacing="10"><TextBlock Text="전략 D · 당일 반복매매" FontSize="26" FontWeight="Bold"/><TextBlock Text="일봉 MA + 매물대 중첩 → 지지 접근 후 새 반등 · 동일 코어로 연구/가상 실행" Classes="muted"/><Border Background="#EAF2FF" Padding="12" CornerRadius="10"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border></StackPanel>
  <TabControl x:Name="Pages" SelectionChanged="PageChanged" Margin="0,12,0,0">
   <TabItem Header="간편 · 고급 설정"><DockPanel Margin="0,12">
    <StackPanel DockPanel.Dock="Top" Spacing="10"><WrapPanel>
     <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset,Mode=TwoWay}" Width="220" Margin="0,0,8,0"/>
     <TextBox Text="{Binding Name,Mode=TwoWay}" Width="210" Margin="0,0,8,0"/>
     <Button Content="추가" Command="{Binding Commands[추가]}"/><Button Content="저장" Command="{Binding Commands[저장]}"/><Button Content="복구" Command="{Binding Commands[복구]}" Classes="secondary"/><Button Content="불러오기" Command="{Binding Commands[불러오기]}" Classes="secondary"/><Button Content="내보내기" Command="{Binding Commands[내보내기]}" Classes="secondary"/><CheckBox Content="고급 설정" IsChecked="{Binding Advanced,Mode=TwoWay}" Margin="14,0"/>
    </WrapPanel><TextBlock Text="원본 체결이 없으면 틱을 만들지 않습니다. 오프라인은 일봉 연구만 지원합니다. 실행 중 설정은 다음 시작 때 적용합니다. 수수료0.015의 정밀도를 유지합니다." Classes="muted" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Margin="0,10,0,0"><StackPanel>
     <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding Editable}"><ItemsControl.ItemTemplate><DataTemplate>
      <Expander Header="{Binding Name}" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,4"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Border Classes="card" Width="315" Padding="12,10" Margin="0,5,10,0" ToolTip.Tip="{Binding Help}"><StackPanel Spacing="6"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><Grid ColumnDefinitions="170,*"><local:SettingInput/><TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="12" Classes="muted" Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Expander Header="당시 종목 상태·위험·시장 세션 JSON" Margin="0,16"><TextBox Text="{Binding FactsJson,Mode=TwoWay}" AcceptsReturn="True" Height="200" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Expander>
    </StackPanel></ScrollViewer>
   </DockPanel></TabItem>
   <TabItem Header="백테스트 · 대상 검증"><Grid RowDefinitions="Auto,150,*" Margin="0,12">
    <StackPanel><WrapPanel><CalendarDatePicker SelectedDate="{Binding StartDate,Mode=TwoWay}"/><TextBlock Text="~" VerticalAlignment="Center" Margin="8,0"/><CalendarDatePicker SelectedDate="{Binding EndDate,Mode=TwoWay}"/><TextBox Text="{Binding SeedCash,Mode=TwoWay}" Width="145" Margin="12,0" ToolTip.Tip="공유 가상 시드머니(원)"/><Button Content="백테스트" Command="{Binding Commands[연구]}"/><Button Content="대상 검증" Command="{Binding Commands[스크리닝]}"/><Button Content="취소" Command="{Binding Commands[취소]}" Classes="secondary"/></WrapPanel><WrapPanel Margin="0,10"><CheckBox Content="수집 원본 이벤트 재생" IsChecked="{Binding RawReplay,Mode=TwoWay}"/><CheckBox Content="봉 연구 가정 허용" IsChecked="{Binding ResearchAssumptions,Mode=TwoWay}" Margin="18,0" ToolTip.Tip="연구에서만 미확인 정규장 시간/거래대금/종목 상태를 명시적 가정으로 사용합니다. 실시간 실행에 전이하지 않으며 확인된 위험은 덮어쓰지 않습니다."/></WrapPanel></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResearch,Mode=TwoWay}" AutoGenerateColumns="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="코드" Binding="{Binding Symbol,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="종목" Binding="{Binding Name,Mode=OneWay}" Width="160"/><DataGridTextColumn Header="신호" Binding="{Binding Signals,Mode=OneWay}" Width="70"/><DataGridTextColumn Header="거래" Binding="{Binding Trades,Mode=OneWay}" Width="70"/><DataGridTextColumn Header="평가손익" Binding="{Binding Profit,Mode=OneWay}" Width="120"/><DataGridTextColumn Header="상태" Binding="{Binding State,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="오류" Binding="{Binding Error,Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid>
    <local:DayTradingChartPanel Grid.Row="2"/>
   </Grid></TabItem>
   <TabItem Header="실시간 가상 실행"><Grid RowDefinitions="Auto,170,*" Margin="0,12">
    <StackPanel Spacing="10"><WrapPanel><TextBlock Text="가상 시드(원)" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Text="{Binding SeedCash,Mode=TwoWay}" Width="150"/><CheckBox Content="신규·추가매수 허용" IsChecked="{Binding AutomaticEntries,Mode=TwoWay}" Margin="16,0"/><Button Content="가상 감시 시작" Command="{Binding Commands[가상시작]}"/><Button Content="신규 진입 중지" Command="{Binding Commands[진입중지]}" Classes="secondary"/><Button Content="긴급중지" Command="{Binding Commands[긴급중지]}" Classes="danger"/></WrapPanel><TextBlock Text="{Binding Connection}" FontWeight="SemiBold"/><TextBlock Text="온라인 키움 국내20종목 이내 · 확인된 세션/시각/종목·위험 자료 필요 · 실제 주문 없음 · 창을 닫아도 감시 유지" Classes="muted" TextWrapping="Wrap"/></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding LiveRows}" SelectedItem="{Binding SelectedLive,Mode=TwoWay}" AutoGenerateColumns="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="종목" Binding="{Binding Symbol,Mode=OneWay}" Width="120"/><DataGridTextColumn Header="전략" Binding="{Binding Strategy,Mode=OneWay}" Width="180"/><DataGridTextColumn Header="상태" Binding="{Binding State,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="보유" Binding="{Binding Quantity,Mode=OneWay}" Width="70"/><DataGridTextColumn Header="평균단가" Binding="{Binding Average,Converter={StaticResource IntegerPrice},Mode=OneWay}" Width="110"/><DataGridTextColumn Header="진입" Binding="{Binding Entries,Mode=OneWay}" Width="70"/><DataGridTextColumn Header="오류" Binding="{Binding Error,Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid>
    <local:DayTradingChartPanel Grid.Row="2"/>
   </Grid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
