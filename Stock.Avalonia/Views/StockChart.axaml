<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:plot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia" x:Class="Stock.Desktop.StockChart">
    <Grid RowDefinitions="28,*,18,72">
        <TextBlock x:Name="HoverInfo" Text="마우스 휠로 확대 · 드래그로 이동 · 모든 시간은 한국시간" Classes="muted" FontSize="11" Margin="0,4" />
        <plot:AvaPlot x:Name="PricePlot" Grid.Row="1" />
        <TextBlock Name="VolumeCaption" Grid.Row="2" Text="거래량" Classes="muted" FontSize="10" />
        <plot:AvaPlot x:Name="VolumePlot" Grid.Row="3" />
        <Canvas Name="TradeLayer" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True" />
        <Canvas Name="GuideLayer" Grid.Row="1" Grid.RowSpan="3" IsHitTestVisible="False" IsVisible="False" ClipToBounds="True">
            <Line Name="VerticalGuide" Stroke="#8B95A1" StrokeThickness="0.6" StrokeDashArray="3,3" />
            <Line Name="HorizontalGuide" Stroke="#8B95A1" StrokeThickness="0.6" StrokeDashArray="3,3" />
            <Border Name="GuidePrice" Background="#F2F4F6" CornerRadius="3" Padding="3,2"><TextBlock Name="GuidePriceText" Foreground="#4E5968" FontSize="11" /></Border>
        </Canvas>
        <TextBlock Name="EmptyNotice" Grid.RowSpan="4" Text="데이터가 없습니다." Foreground="#8B95A1" VerticalAlignment="Center" Margin="24,0" IsHitTestVisible="False" />
    </Grid>
</UserControl>
