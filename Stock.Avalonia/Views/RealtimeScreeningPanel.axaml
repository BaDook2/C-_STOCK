<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Stock.Desktop" x:Class="Stock.Desktop.RealtimeScreeningPanel">
    <DockPanel Margin="0,16">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <local:ScreeningSettings DataContext="{Binding $parent[Window].DataContext.Screening}" />
            <WrapPanel>
                <Button Content="실시간 스크리닝 시작" Command="{Binding Start}" />
                <Button Content="중지" Command="{Binding Stop}" Classes="danger" />
                <Button Content="차트·가상 체결 보기" Command="{Binding OpenChart}" Classes="secondary" />
                <CheckBox Content="자동매매 시작 · 가상 계좌" IsEnabled="{Binding CanAutomatic}" ToolTip.Tip="일봉은 신호 감시만 지원합니다. 가상 자동매매는 온라인 지정봉을 선택하세요." IsChecked="{Binding Automatic,Mode=TwoWay}" Margin="8,0" />
                <CheckBox Content="전체 감시 대상" IsChecked="{Binding ShowAll,Mode=TwoWay}" Margin="8,0" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="전체 가상 투자 한도" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding TotalBudget,Mode=TwoWay}" Width="170" Margin="0,0,16,0" />
                <TextBlock Text="일 손실 한도" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding DailyLossLimit,Mode=TwoWay}" Width="160" />
            </WrapPanel>
            <CheckBox Content="가상모형에서 미확인 종목 분류·악재를 일반주식·악재 없음으로 가정" IsChecked="{Binding PaperAssumptions,Mode=TwoWay}" ToolTip.Tip="기본 꺼짐. 실제 확인값을 덮어쓰지 않으며 실계좌 주문에 적용되지 않습니다." />
            <TextBlock Text="접근도는 확률이 아닙니다. 실제 전략 조건이 충족된 새 신호만 가상 엔진으로 전달합니다. 관측시세 모형이며 급락 판단 전략의 원본 체결 가상 실행은 가상 계좌 전략 실행에서 시작합니다." Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3" />
        </StackPanel>
        <Border Margin="0,18,0,0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected,Mode=TwoWay}" AutoGenerateColumns="False" DoubleTapped="OpenDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="코드" Binding="{Binding Code,Mode=OneWay}" Width="85" />
                    <DataGridTextColumn Header="종목" Binding="{Binding Name,Mode=OneWay}" Width="140" />
                    <DataGridTextColumn Header="현재가" Binding="{Binding Price,Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="등락률" Binding="{Binding Change,Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="접근도" Binding="{Binding Proximity,Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="충족" Binding="{Binding Conditions,Mode=OneWay}" Width="70" />
                    <DataGridTextColumn Header="전략 상태" Binding="{Binding State,Mode=OneWay}" Width="140" />
                    <DataGridTextColumn Header="미충족 조건" Binding="{Binding Unmet,Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="시세 시각" Binding="{Binding Time,Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="수신 상태" Binding="{Binding Data,Mode=OneWay}" Width="175" />
                    <DataGridTextColumn Header="가상 주문" Binding="{Binding Orders,Mode=OneWay}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>